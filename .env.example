# Copy to .env.local and fill in. Never commit real values.
# Supabase > Connect > Connection pooling. Replace the placeholders.

# Transaction pooler (port 6543) - used by the app.
# The user is the app role created by migration 0004 (salary_app), not postgres: it is least-privilege
# and has a server-side statement timeout. Set its password once (see README, "Database setup").
DATABASE_URL=postgresql://salary_app.[PROJECT-REF]:[APP-ROLE-PASSWORD]@[POOLER-HOST]:6543/postgres

# Session pooler (port 5432 on the pooler host) - migrations and seed only, as the postgres user.
# Not the direct db.[PROJECT-REF].supabase.co host: that one is IPv6-only on the free plan.
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres
